new file mode 100644
index 0000000..94e764b
--- /dev/null
+++ b/apps/docs/src/stories/getting-started/Installation.mdx
@@ -0,0 +1,86 @@
+import { Meta } from '@storybook/blocks';
+
+<Meta 
+  title="Getting Started/Installation"
+  parameters={{
+    viewMode: 'docs',
+    previewTabs: { 
+      canvas: { hidden: true } 
+    },
+    docs: {
+      toc: {
+        title: 'On this page',
+        disable: false,
+        headingSelector: 'h2, h3'
+      }
+    }
+  }}
+/>
+
+# Installation
+
+Follow these steps to add the Webstacks Design System to your project.
+
+## Using npm
+
+```bash
+npm install @webstacks/ui
+```
+
+## Using pnpm
+
+```bash
+pnpm add @webstacks/ui
+```
+
+## Using yarn
+
+```bash
+yarn add @webstacks/ui
+```
+
+## Basic Usage
+
+```jsx
+import { Button } from '@webstacks/ui';
+
+function App() {
+  return (
+    <Button variant="primary">
+      Click me
+    </Button>
+  );
+}
+```
+
+## Configuration
+
+### 1. Add Tailwind CSS Configuration
+
+Add the Webstacks Design System plugin to your `tailwind.config.js`:
+
+```js
+module.exports = {
+  content: [
+    './src/**/*.{js,jsx,ts,tsx}',
+    './node_modules/@webstacks/ui/**/*.{js,jsx,ts,tsx}',
+  ],
+  plugins: [
+    require('@webstacks/ui/plugin'),
+  ],
+};
+```
+
+### 2. Import Styles
+
+Import the base styles in your main CSS file:
+
+```css
+@import '@webstacks/ui/styles.css';
+```
+
+## Next Steps
+
+- Check out our [Design Guidelines](/docs/getting-started-design-guidelines--docs) to learn about our design principles
+- Browse our [Components](/docs/primitives-overview--docs) to see what's available
+- Read the [Contributing Guide](/docs/getting-started-contributing--docs) if you'd like to contribute
