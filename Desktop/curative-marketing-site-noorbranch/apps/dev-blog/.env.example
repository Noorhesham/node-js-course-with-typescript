# Sanity Configuration
NEXT_PUBLIC_SANITY_API_VERSION=YYYY-MM-DD
NEXT_PUBLIC_SANITY_USE_CDN=true
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=dev_or_production
NEXT_PUBLIC_SANITY_STUDIO_URL=your_studio_url

# API Keys (Client-side)
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key
NEXT_PUBLIC_SEGMENT_API_KEY=your_segment_api_key

# API Keys (Server-side only)
SANITY_READ_TOKEN=your_sanity_token
HUBSPOT_ACCESS_TOKEN=your_hubspot_token
CLEARBIT_API_KEY=your_clearbit_key